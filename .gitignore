# Build output
/aegis
/aegis.exe
/aegis-eval.exe
/dist/

# Local test runs and scratch output
/testrun/

# Web UI frontend (internal/server/webui/frontend) — node_modules only;
# the built dist/ is committed so `go build`/`go run` need no Node.js.
internal/server/webui/frontend/node_modules/

# Local config & data (project-level skills are shared, so carve those out)
/.aegis/*
!/.aegis/skills
*.db
*.log
*.err

# Secrets. .aegis/.env is already covered by /.aegis/* above; this catches a
# bare .env at the repo root or in any subdirectory (e.g. one dropped in for
# local testing, as happened 2026-08-19 — a Tavily key sat untracked but
# unignored at the repo root).
.env
.env.*

# Editor / OS
.DS_Store
.idea/
.vscode/

# Python bytecode from the bundled threat-modeling scripts (never embedded:
# //go:embed builtin skips `_`-prefixed dirs, so these are pure local noise)
__pycache__/
*.pyc
