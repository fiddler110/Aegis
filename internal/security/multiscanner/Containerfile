# Aegis multiscanner image.
#
# One image carrying every filesystem security scanner Aegis knows how to
# drive, so an operator provisions once instead of installing 16 tools (or
# configuring 16 separate container images) before `aegis scan` is whole.
#
# Built locally by `aegis security build-image`, which records the resulting
# image ID into config and re-verifies it before every container run — that
# pin, not a registry digest, is what binds Aegis to this exact image.
#
# Deliberately NOT here:
#   zap     - large Java app with its own mount contract (/zap/wrk:rw); keeps
#             its own official image (see internal/security/dast.go).
#   dockle  - inspects a built image through the local container engine socket,
#             so it needs the engine socket — a privilege axis (effectively host
#             root) neither Aegis image grants (internal/security/images.go).
#
# Note on grype and trivy: their binaries are carried here for source scanning
# (grype dir:/src, trivy fs). Scanning a built container *image* by reference
# needs registry egress, which this image denies — that runs from the netscanner
# stage further down instead, which has network and no workspace.
#
# This file builds TWO images. The default target is the multiscanner (offline,
# workspace-mounted); `--target netscanner` builds the network-facing one. They
# share this context on purpose: one fetch.sh, one set of pinned versions, one
# source fingerprint.
#
# PROFILE=core  static scanner binaries only (no Python/Ruby/Go/network tools).
# PROFILE=full  everything: adds bandit/njsscan (Python), brakeman
#               (Ruby), gosec + the Go toolchain (Go), nmap + nuclei (network).
ARG PROFILE=full

# ─────────────────────────────────────────────────────────────────────────────
# fetch — pinned, checksum-verified static binaries
# ─────────────────────────────────────────────────────────────────────────────
FROM debian:bookworm-slim AS fetch

RUN apt-get update \
	&& apt-get install -y --no-install-recommends ca-certificates curl tar unzip \
	&& rm -rf /var/lib/apt/lists/*

# Bump a version and its sibling checksum together; see fetch.sh. Nothing
# resolves "latest" — a floating scanner version is the same class of problem
# as a floating image tag.
ARG TRIVY_VERSION=0.72.0
ARG GITLEAKS_VERSION=8.30.1
ARG TRUFFLEHOG_VERSION=3.95.9
ARG SYFT_VERSION=1.48.0
ARG OSV_SCANNER_VERSION=2.4.0
ARG GRYPE_VERSION=0.116.0
ARG KUBESCAPE_VERSION=4.0.10
ARG HADOLINT_VERSION=2.14.0
ARG OPENGREP_VERSION=1.25.0
# opengrep publishes sigstore signatures, not checksums — digest pinned here.
ARG OPENGREP_SHA256=9ac4aebb47ba3f7b0d8fc641ac8749cb6c2f253f616131a67d9631e00d4bea33
ARG NUCLEI_VERSION=3.11.0
ARG GOSEC_VERSION=2.28.0
# The Go toolchain gosec needs to load packages. go.dev serves checksums on its
# download index rather than beside the artifact, so this is digest-pinned here
# the same way opengrep is — bump the pair together. See fetch.sh's get_go.
ARG GO_VERSION=1.26.5
ARG GO_SHA256=5c2c3b16caefa1d968a94c1daca04a7ca301a496d9b086e17ad77bb81393f053

COPY fetch.sh /usr/local/bin/fetch.sh
RUN chmod +x /usr/local/bin/fetch.sh && /usr/local/bin/fetch.sh

# ─────────────────────────────────────────────────────────────────────────────
# py — bandit / njsscan in a self-contained venv (full profile only)
# ─────────────────────────────────────────────────────────────────────────────
FROM debian:bookworm-slim AS py

RUN apt-get update \
	&& apt-get install -y --no-install-recommends python3 python3-venv python3-pip gcc python3-dev \
	&& rm -rf /var/lib/apt/lists/*

ARG BANDIT_VERSION=1.9.4
ARG NJSSCAN_VERSION=0.4.3

# One venv per tool, not one shared venv: njsscan pins an exact, long-stale
# version of its own analysis engine (0.4.3 wants semgrep==1.86.0), so sharing
# a venv risks pip resolving the whole install into ResolutionImpossible as
# soon as another tool wants a different version. This is the same isolation
# `pipx install` gives, which is what each tool's ScannerDescriptor.Install
# already recommends.
#
# Pinned exactly, for the same reason the binaries above are. --no-cache-dir
# keeps the layer from carrying pip's download cache into the copy.
RUN set -eux; \
	for spec in \
	"bandit:bandit[sarif]==${BANDIT_VERSION}" \
	"njsscan:njsscan==${NJSSCAN_VERSION}" \
	; do \
	name="${spec%%:*}"; req="${spec#*:}"; \
	python3 -m venv "/opt/venv/${name}"; \
	"/opt/venv/${name}/bin/pip" install --no-cache-dir --upgrade pip; \
	"/opt/venv/${name}/bin/pip" install --no-cache-dir "${req}"; \
	test -x "/opt/venv/${name}/bin/${name}" || { echo "${name} entrypoint missing after install" >&2; exit 1; }; \
	done

# ─────────────────────────────────────────────────────────────────────────────
# core — static scanners + baked vulnerability databases
# ─────────────────────────────────────────────────────────────────────────────
FROM debian:bookworm-slim AS profile-core

# curl/unzip are runtime dependencies of aegis-update-db (it fetches and
# verifies the OSV archives). git is needed by scanners that inspect repository
# history.
RUN apt-get update \
	&& apt-get install -y --no-install-recommends ca-certificates curl git unzip \
	&& rm -rf /var/lib/apt/lists/*

# gosec is deliberately absent from *this* stage and present in profile-full
# below. It is compile-assisted — it resolves packages through `go list`, so it
# needs a Go toolchain and a warm module cache, and it does not fail when it has
# neither: with no toolchain it reports zero, and with a toolchain but no modules
# it quietly drops every type-aware rule (measured on the Aegis repo: host 244,
# no toolchain 0, cold cache 258, warm cache 283). Carrying it here would add
# ~250MB of Go toolchain to the profile whose whole point is static scanner
# binaries, so it rides with the other language-targeted analyzers instead. How
# the module cache is warmed without giving the analysis run network access is
# P55.8's two-phase split — see gosec.go.
COPY --from=fetch /out/trivy /out/gitleaks /out/trufflehog /out/syft \
	/out/osv-scanner /out/grype /out/kubescape \
	/out/hadolint /out/opengrep /usr/local/bin/

# Vulnerability databases are NOT baked into the image — they were ~3.7GB of a
# 5.8GB image. They live in a cache volume mounted at /cache instead, populated
# by `aegis security update-db` (the only thing that gets network access) and
# read by scans, which still run with --network none.
#
# These env vars are what make that split work. The cache paths point into the
# volume, and the TRIVY_SKIP_*_UPDATE flags stop scans from attempting a fetch
# they cannot perform — without them a scan against an empty cache would hang
# on DNS and fail confusingly rather than reporting a clear "run update-db".
# aegis-update-db flips the skips off for its own run.
#
# XDG_CACHE_HOME redirects osv-scanner (and opengrep) into the volume too:
# both cache under $XDG_CACHE_HOME/$HOME, and osv-scanner's DB is the other
# thing update-db populates.
#
# GRYPE_DB_CACHE_DIR points grype's vulnerability DB at the same volume; the DB
# lives at $GRYPE_DB_CACHE_DIR/<schema>/vulnerability.db (schema == grype's
# ModelVersion, 6 for the pinned GRYPE_VERSION). GRYPE_DB_AUTO_UPDATE=false and
# GRYPE_DB_REQUIRE_UPDATE_CHECK=false keep scans from reaching the network for a
# DB refresh; GRYPE_DB_VALIDATE_AGE=false stops grype refusing an air-gapped DB
# that has aged past its 120h staleness window (update-db can't run on every
# scan, so a cached DB is expected to be "old"). aegis-update-db flips
# GRYPE_DB_AUTO_UPDATE on for its own run.
ENV HOME=/opt/aegis-home \
	AEGIS_CACHE_DIR=/cache \
	XDG_CACHE_HOME=/cache \
	TRIVY_CACHE_DIR=/cache/trivy \
	TRIVY_SKIP_DB_UPDATE=true \
	TRIVY_SKIP_JAVA_DB_UPDATE=true \
	TRIVY_SKIP_CHECK_UPDATE=true \
	GRYPE_DB_CACHE_DIR=/cache/grype/db \
	GRYPE_DB_AUTO_UPDATE=false \
	GRYPE_DB_REQUIRE_UPDATE_CHECK=false \
	GRYPE_DB_VALIDATE_AGE=false

# /cache is a mountpoint at runtime; create it (and a writable HOME) so the
# image is still usable if someone runs it without the volume.
RUN mkdir -p "$HOME" /cache && chmod 777 "$HOME" /cache

COPY update-db.sh /usr/local/bin/aegis-update-db
RUN chmod +x /usr/local/bin/aegis-update-db

# Bake the SAST rule packs. "Pinned" registry packs (p/owasp-top-ten) are still
# fetched from semgrep.dev at scan time — pinning the name doesn't make them
# local — so a network-less container can't use them by reference. The scanner
# points --config at these files instead when running from this image (see
# multiscannerRulePackPath in ../multiscanner.go).
ARG SAST_RULES_BASE=https://semgrep.dev/c/p
RUN set -eux; \
	mkdir -p /opt/semgrep-rules; \
	for pack in owasp-top-ten security-audit; do \
	curl -fsSL --retry 3 "${SAST_RULES_BASE}/${pack}" -o "/opt/semgrep-rules/${pack}.yaml"; \
	# A registry error page would download happily and then fail at scan time
	# as an empty rule set; require it to actually look like rules.
	grep -q "rules:" "/opt/semgrep-rules/${pack}.yaml" || { echo "${pack}.yaml has no rules: key" >&2; exit 1; }; \
	done; \
	chmod -R a+rX /opt/semgrep-rules

# Bake kubescape's rego policy library. Like opengrep's rule packs, kubescape
# carries no policies in its binary — it fetches them from the regolibrary
# GitHub release on every run, so a --network none container died outright:
# "open $HOME/.kubescape/allcontrols.json: no such file or directory" (fatal,
# exit 1, empty stdout). `download artifacts` is the supported way to
# pre-populate that cache, and it writes the exact layout the offline loader
# expects (attack-tracks.json, controls-inputs.json, exceptions.json, one
# <framework>.json per framework) — hand-fetching the release assets does not:
# their filenames and contents differ from what the cache loader reads back.
#
# Note this only makes the *explicit-framework* path work (`kubescape scan
# framework allcontrols /src`). Bare `kubescape scan /src` defaults to the
# "workloadscan" framework, which fails from cache with "framework from file
# not matching" even when workloadscan.json is present — so the container
# invocation names a framework (see kubescapeScanner.Scan in ../scanners.go).
RUN set -eux; \
	kubescape download artifacts --output "$HOME/.kubescape"; \
	# An empty/partial cache would leave kubescape fataling at scan time, so
	# require the framework the scanner actually asks for to be present.
	test -s "$HOME/.kubescape/allcontrols.json"; \
	test -s "$HOME/.kubescape/attack-tracks.json"; \
	chmod -R a+rX "$HOME/.kubescape"

# A scan mounts the workspace read-write at /src but tools must not need to
# write outside it; /tmp as HOME covers opengrep's dotfile writes.
WORKDIR /src

# No ENTRYPOINT, deliberately. Every other scanner image entrypoints its own
# tool, so Aegis passes bare args; a shared image can't do that. Aegis prepends
# the binary name instead (see runScannerImage in internal/security/method.go).
ENTRYPOINT []
CMD ["/bin/sh", "-c", "echo 'aegis multiscanner: invoke a scanner by name, e.g. trivy fs /src' >&2; exit 64"]

# ─────────────────────────────────────────────────────────────────────────────
# full — core + Python + Ruby + network scanners
# ─────────────────────────────────────────────────────────────────────────────
FROM profile-core AS profile-full

# brakeman is capped at 7.1.1, not "latest": debian:bookworm ships Ruby 3.1.2,
# and brakeman 7.1.2+ requires Ruby >= 3.2.0 (it fails the install outright).
# Raising this needs a base image with a newer Ruby, not just a version bump.
ARG BRAKEMAN_VERSION=7.1.1
RUN apt-get update \
	&& apt-get install -y --no-install-recommends python3 ruby ruby-dev build-essential nmap \
	&& gem install --no-document brakeman -v "${BRAKEMAN_VERSION}" \
	&& apt-get purge -y --auto-remove ruby-dev build-essential \
	&& rm -rf /var/lib/apt/lists/* \
	&& brakeman --version

COPY --from=py /opt/venv /opt/venv
COPY --from=fetch /out/nuclei /usr/local/bin/nuclei
COPY --from=fetch /out/gosec /usr/local/bin/gosec
COPY --from=fetch /out/go /usr/local/go

# gosec's environment. Every path here points into /gocache, which is a mounted
# volume at runtime (AegisGoCacheVolume) rather than image content — that is
# what lets the networked warm phase and the --network none analysis phase see
# the same modules without the analysis phase ever being able to fetch.
#
# GOFLAGS=-mod=readonly is load-bearing, not tidiness: the warm phase mounts the
# workspace READ-ONLY, and a Go that decides it needs to update go.mod/go.sum
# would fail on the mount rather than on the thing that is actually wrong. With
# readonly it says so directly ("missing go.sum entry ... run go mod download").
#
# GOTOOLCHAIN=auto lets a repo whose go.mod names a newer Go than ${GO_VERSION}
# still be analyzed: the warm phase (which has network) downloads that toolchain
# into GOMODCACHE, and the analysis phase finds it already there. Without it,
# such a repo would fail outright on any toolchain bump upstream of this image.
ENV PATH=/usr/local/go/bin:$PATH \
	GOPATH=/gocache/gopath \
	GOMODCACHE=/gocache/mod \
	GOCACHE=/gocache/build \
	GOFLAGS=-mod=readonly \
	GOTOOLCHAIN=auto
RUN mkdir -p /gocache && chmod 777 /gocache \
	&& go version \
	&& gosec --version

# Each tool lives in its own venv (see the py stage), so put the entrypoints on
# PATH by name rather than adding a shared venv's bin/ — there isn't one.
#
# A wrapper rather than a bare symlink, because njsscan does not only import
# its engine — it shells out to a `semgrep` binary by name (libsast's
# core_sgrep invokes it via subprocess). A symlink puts njsscan on PATH but not
# its venv's siblings, so that lookup escapes to the system PATH. While a
# standalone semgrep existed at /usr/local/bin/semgrep this happened to
# resolve; when semgrep was removed as a first-class scanner, njsscan started
# dying with FileNotFoundError: 'semgrep' on every run. Its own correctly
# pinned semgrep==1.86.0 was in /opt/venv/njsscan/bin the whole time — just
# unreachable. Prepending the tool's own venv bin keeps each venv isolated
# (the reason they're separate) while letting a tool find its own dependencies.
#
# Note the --version check below passed throughout that breakage: `njsscan
# --version` never reaches the semgrep subprocess. A version probe cannot
# establish that a scanner works — see P55.3.
RUN set -eux; \
	for name in bandit njsscan; do \
	printf '#!/bin/sh\nexec env PATH="/opt/venv/%s/bin:$PATH" "/opt/venv/%s/bin/%s" "$@"\n' "${name}" "${name}" "${name}" > "/usr/local/bin/${name}"; \
	chmod 0755 "/usr/local/bin/${name}"; \
	"/usr/local/bin/${name}" --version >/dev/null 2>&1 || { echo "${name} is not runnable" >&2; exit 1; }; \
	done; \
	# Assert the dependency the wrapper exists for is actually reachable —
	# this, not --version, is what would have caught the breakage above.
	env PATH="/opt/venv/njsscan/bin:$PATH" semgrep --version >/dev/null 2>&1 \
	|| { echo "njsscan cannot reach its bundled semgrep" >&2; exit 1; }

ARG NUCLEI_TEMPLATES_VERSION=v10.4.6
ENV NUCLEI_TEMPLATES_DIR=/opt/nuclei-templates
# Templates are executable network-probe logic, so they're pinned to a release
# tag and baked in rather than pulled at scan time — the same posture the
# nuclei scanner already enforces via security.tools.nuclei.templates_version.
#
# Fetched as the tagged source tarball rather than via `nuclei
# -update-templates`, which always resolves to the latest release and would
# quietly ignore the pin above.
# curl/ca-certificates come from profile-core and are deliberately NOT purged
# here: --auto-remove would strip them back out of the base stage, and
# ca-certificates going missing would break TLS for anything that needs it.
RUN set -eux; \
	mkdir -p "${NUCLEI_TEMPLATES_DIR}"; \
	curl -fsSL --retry 3 \
	"https://github.com/projectdiscovery/nuclei-templates/archive/refs/tags/${NUCLEI_TEMPLATES_VERSION}.tar.gz" \
	-o /tmp/templates.tar.gz; \
	tar -xzf /tmp/templates.tar.gz -C "${NUCLEI_TEMPLATES_DIR}" --strip-components=1; \
	rm -f /tmp/templates.tar.gz; \
	chmod -R a+rX "${NUCLEI_TEMPLATES_DIR}"; \
	test -d "${NUCLEI_TEMPLATES_DIR}/http" || { echo "nuclei templates ${NUCLEI_TEMPLATES_VERSION} look wrong: no http/ dir" >&2; exit 1; }

# ─────────────────────────────────────────────────────────────────────────────
# netscanner — P55.7: the second image, split by MOUNT POSTURE, not by tool
#              category. Built with `--target netscanner` from this same
#              context, so there is one fetch.sh, one set of pinned versions,
#              and one source fingerprint covering both images.
# ─────────────────────────────────────────────────────────────────────────────
#
# Every tool here needs network egress and none of them needs the workspace,
# because each one scans a REMOTE target rather than local source:
#
#   nmap, nuclei    egress to the target host; take a target list
#   trivy image     registry egress; takes an image reference
#   grype <ref>     registry egress; takes an image reference
#
# That is the whole reason a second image exists. The scanner hardening forbids
# network-plus-workspace in one container because it is an exfiltration path out
# of a hostile repo — but these four have nothing to exfiltrate, since they never
# see the source. So this image runs with network ON and **no workspace mount,
# ever**, and the invariant is structural rather than conventional: its runner
# (runNetscannerImage in ../netscanner.go) takes no directory parameter at all.
# The multiscanner's --network none + workspace-mounted runner is untouched, and
# the two never converge.
#
# Deliberately NOT here:
#   zap     already solved — dast.go runs the official zaproxy image with its own
#           /zap/wrk mount contract, so it already needs no host install. Folding
#           a large Java app in here would buy nothing.
#   dockle  needs the container ENGINE SOCKET, which is a third privilege axis:
#           socket access is effectively host root, not merely egress. Whether
#           Aegis should mount a container socket at all deserves its own
#           decision rather than arriving as a side effect of this image.
FROM debian:bookworm-slim AS netscanner

# nmap from the distro: it is a C program with a large data set (service probes,
# NSE scripts), not a static release binary like the tools in the fetch stage.
RUN apt-get update \
	&& apt-get install -y --no-install-recommends ca-certificates curl nmap \
	&& rm -rf /var/lib/apt/lists/*

COPY --from=fetch /out/trivy /out/grype /out/nuclei /usr/local/bin/

# This image's cache is its OWN volume, not the multiscanner's
# (AegisNetscannerCacheVolume vs MultiscannerCacheVolume). Two reasons, and the
# second is the one that matters: this container has network, so it can refresh
# its own databases on demand and needs no `update-db` step at all — which is
# also why the TRIVY_SKIP_*/GRYPE_DB_AUTO_UPDATE flags are the *opposite* of the
# multiscanner's. Pointing both at one volume would put a networked writer
# inside the cache that the offline scans read, and there is no reason to accept
# that when a second volume costs nothing.
ENV HOME=/opt/aegis-home \
	AEGIS_CACHE_DIR=/cache \
	XDG_CACHE_HOME=/cache \
	TRIVY_CACHE_DIR=/cache/trivy \
	GRYPE_DB_CACHE_DIR=/cache/grype/db \
	GRYPE_DB_AUTO_UPDATE=true

RUN mkdir -p "$HOME" /cache && chmod 777 "$HOME" /cache

ARG NUCLEI_TEMPLATES_VERSION=v10.4.6
ENV NUCLEI_TEMPLATES_DIR=/opt/nuclei-templates
# Baked and pinned for the same reason as in profile-full: templates are
# executable network-probe logic and are never pulled at an unpinned "latest".
# Baking them also removes the host-side git clone the recon scanner needs on
# the host path (resolveNucleiTemplates), which is why the container path can
# run without security.tools.nuclei.templates_version being set at all.
RUN set -eux; \
	mkdir -p "${NUCLEI_TEMPLATES_DIR}"; \
	curl -fsSL --retry 3 \
	"https://github.com/projectdiscovery/nuclei-templates/archive/refs/tags/${NUCLEI_TEMPLATES_VERSION}.tar.gz" \
	-o /tmp/templates.tar.gz; \
	tar -xzf /tmp/templates.tar.gz -C "${NUCLEI_TEMPLATES_DIR}" --strip-components=1; \
	rm -f /tmp/templates.tar.gz; \
	chmod -R a+rX "${NUCLEI_TEMPLATES_DIR}"; \
	test -d "${NUCLEI_TEMPLATES_DIR}/http" || { echo "nuclei templates ${NUCLEI_TEMPLATES_VERSION} look wrong: no http/ dir" >&2; exit 1; }

# /tmp, not /src. There is no /src in this image and there never will be — see
# the header. Tools that need to write a report write it here and Aegis cats it
# back out over stdout, because with no mount there is no shared file to read.
WORKDIR /tmp

ARG AEGIS_NETSCANNER_VERSION=v1
LABEL org.opencontainers.image.title="aegis-netscanner" \
	org.opencontainers.image.description="Aegis network- and registry-facing security scanners (no workspace mount)" \
	org.opencontainers.image.source="https://github.com/fiddler110/aegis" \
	io.aegis.netscanner.version="${AEGIS_NETSCANNER_VERSION}"

ENTRYPOINT []
CMD ["/bin/sh", "-c", "echo 'aegis netscanner: invoke a scanner by name, e.g. nmap -sV 10.0.0.1' >&2; exit 64"]

# ─────────────────────────────────────────────────────────────────────────────
# final — selected by --build-arg PROFILE=core|full
# ─────────────────────────────────────────────────────────────────────────────
FROM profile-${PROFILE} AS final

ARG PROFILE
ARG AEGIS_MULTISCANNER_VERSION=v1
LABEL org.opencontainers.image.title="aegis-multiscanner" \
	org.opencontainers.image.description="Aegis bundled security scanners" \
	org.opencontainers.image.source="https://github.com/fiddler110/aegis" \
	io.aegis.multiscanner.profile="${PROFILE}" \
	io.aegis.multiscanner.version="${AEGIS_MULTISCANNER_VERSION}"
