# Canary: synthetic credentials. None of these was ever issued, none refers to
# a real account, and none authenticates to anything.
#
# The AWS pair is the canonical example key from AWS's own SigV4 documentation.
# It is here as documentation of a trap rather than as a working canary: both
# gitleaks and trufflehog explicitly allowlist it, so a fixture that planted
# only this would report "0 secrets found" and look exactly like a broken
# secret scanner. Keep at least one planted value that a detector will actually
# fire on, or this file stops testing anything.
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY

# gitleaks fires on this one (rule github-pat): the shape is right and the
# characters spell out what it is.
GITHUB_TOKEN=ghp_NOTAREALTOKENNOTAREALTOKENNOTAREALTO

# trufflehog's Github detector needs more entropy than the line above has, so
# this one is a visibly counted-out a1b2c3… sequence rather than English.
GITHUB_TOKEN_CI=ghp_A1b2C3d4E5f6G7h8I9j0K1l2M3n4O5p6Q7r8
